        /// Initializes a new instance of the <see cref="{{ categoryname }}Attribute"/> class with a string ID.
        /// </summary>
        /// <param name="id">The {{ categoryname }} ID as a string.</param>
        public {{ categoryname }}Attribute(string id)
        {
            Id = id;
        }

        /// <summary>
