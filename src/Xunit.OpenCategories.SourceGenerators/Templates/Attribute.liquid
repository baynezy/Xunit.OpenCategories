        /// </summary>
        /// <param name="id">The {{ categoryname }} ID as a long.</param>
        public {{ categoryname }}Attribute(long id)
        {
            Id = id.ToString();
        }

        /// <summary>
        /// Initializes a new instance of the <see cref="{{ categoryname }}Attribute"/> class.
        /// </summary>
        public {{ categoryname }}Attribute()
        {
        }

        /// <summary>
